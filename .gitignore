# Allow only the public application distribution and synthetic checks.
*
!/.gitignore
!/LICENSE
!/README.md
!/PRD.md
!/ROADMAP.md
!/public/
/public/*
!/public/index.html
!/public/app.css
!/public/app.js
!/test/
/test/*
!/test/smoke.mjs

!/praxis-provider.mjs
!/test/provider.test.mjs

# App-owned registration metadata and audited icon.
!/praxis-app.json
!/apps.example.json
!/public/praxis-icon.svg

# Reviewed source-only Praxis integration helpers.
!/praxis-integration.mjs
!/praxis/
/praxis/*
!/praxis/README.md
!/praxis/web.mjs
!/praxis/storage.mjs
!/praxis/deployment.mjs
!/praxis/local-compose.mjs
!/praxis/stack.mjs
